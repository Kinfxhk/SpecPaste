<Window x:Class="SpecPaste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecPaste — 電腦資訊"
        Height="720" Width="760"
        FontFamily="Microsoft JhengHei UI, Segoe UI"
        Background="White" Foreground="Black">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="重新整理" Padding="10,4" Margin="0,0,6,0" Click="OnRefresh" />
            <Button Content="複製純文字" Padding="10,4" Margin="0,0,6,0" Click="OnCopyText" />
            <Button Content="複製 Markdown" Padding="10,4" Margin="0,0,6,0" Click="OnCopyMarkdown" />
            <Button Content="複製 BBCode" Padding="10,4" Margin="0,0,6,0" Click="OnCopyBbCode" />
            <Button Content="儲存為 .txt" Padding="10,4" Margin="0,0,6,0" Click="OnSave" />
        </StackPanel>
        <TextBox x:Name="View" IsReadOnly="True"
                 FontFamily="Consolas, Microsoft JhengHei UI"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 BorderThickness="1" Padding="6" />
    </DockPanel>
</Window>
